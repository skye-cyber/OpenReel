{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "openreel",
  "version": "0.1.0",
  "identifier": "com.skye.openreel",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:4043",
    "beforeDevCommand": "npm run dev:react",
    "beforeBuildCommand": "npm run build:react"
  },
  "app": {
    "windows": [
      {
        "title": "openreel",
        "url": "../index.html",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
      "enable": true,
      "scope": ["$RESOURCE/**", "$APPDATA/**", "$HOME/.openreel/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources":{
      "../assets/": "assets/"
    }
  }
}
